# Copy to RELEASE.local (same directory) — not tracked by git.
#
# Makefile includes this file AFTER configure/RELEASE, so assignments
# here override defaults. Required at facility deployments.

# ── Developer workstation (flat support tree) ─────────────────────────────
#MODULES = /epics/support2
#EPICS_BASE = /epics/epics-base
#PVXS = $(MODULES)/pvxs

# ── Facility example (uncomment and set paths for your site) ──────────────
#MODULES = /path/to/facility/epics/modules
#EPICS_BASE = $(MODULES)/base/main
#PVXS = $(MODULES)/pvxs/main

# Pixi Python for PyDevice / hkl bindings (recommended)
#PYTHON_CONFIG = $(TOP)/.pixi/envs/default/bin/python3.12-config

# System Python only when building hkl from source (run_HKL.sh option 2)
#PYTHON_CONFIG = /usr/bin/python3-config
