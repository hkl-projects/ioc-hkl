    </actions>
    <pv_name>$(Sys)setup_vis</pv_name>
    <text>start</text>
    <x>54</x>
    <y>370</y>
    <width>86</width>
    <height>22</height>
    <border_alarm_sensitive>false</border_alarm_sensitive>
