<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>HKL_settings</name>
  <macros>
    <Sys>HB3:ioc-hkl:</Sys>
  </macros>
  <width>1750</width>
  <height>1800</height>
  <widget type="embedded" version="2.0.0">
    <name>Embedded Display_3</name>
    <file>windows/initials.bob</file>
    <width>1530</width>
    <height>750</height>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>tabs</name>
    <actions>
      <action type="open_display">
        <description>Help</description>
        <file>motorx_help.opi</file>
        <macros>
          <M>$(M1)</M>
        </macros>
        <target>tab</target>
      </action>
      <action type="open_display">
        <description>reflections</description>
        <file>windows/reflections.bob</file>
        <macros>
          <M>$(M1)</M>
        </macros>
        <target>tab</target>
      </action>
    </actions>
    <text></text>
    <x>140</x>
    <y>640</y>
    <width>30</width>
    <background_color>
      <color red="115" green="223" blue="255">
      </color>
    </background_color>
    <tooltip>$(actions)</tooltip>
    <border_alarm_sensitive>false</border_alarm_sensitive>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>tabs_1</name>
    <actions>
      <action type="open_display">
        <description>Help</description>
        <file>motorx_help.opi</file>
        <macros>
          <M>$(M1)</M>
        </macros>
        <target>tab</target>
      </action>
      <action type="open_display">
        <description>reflections</description>
        <file>windows/reflections.bob</file>
        <macros>
          <M>$(M1)</M>
        </macros>
        <target>tab</target>
      </action>
    </actions>
    <text></text>
    <x>210</x>
    <y>640</y>
    <width>30</width>
    <background_color>
      <color red="115" green="223" blue="255">
      </color>
    </background_color>
    <tooltip>$(actions)</tooltip>
    <border_alarm_sensitive>false</border_alarm_sensitive>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>tabs_2</name>
    <actions>
      <action type="open_display">
        <description>Help</description>
        <file>motorx_help.opi</file>
        <macros>
          <M>$(M1)</M>
        </macros>
        <target>tab</target>
      </action>
      <action type="open_display">
        <description>reflections</description>
        <file>windows/reflections.bob</file>
        <macros>
          <M>$(M1)</M>
        </macros>
        <target>tab</target>
      </action>
    </actions>
    <text></text>
    <x>280</x>
    <y>640</y>
    <width>30</width>
    <background_color>
      <color red="115" green="223" blue="255">
      </color>
    </background_color>
    <tooltip>$(actions)</tooltip>
    <border_alarm_sensitive>false</border_alarm_sensitive>
  </widget>
</display>
