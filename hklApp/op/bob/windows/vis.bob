<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>Visual</name>
  <width>870</width>
  <widget type="image" version="2.0.0">
    <name>Image</name>
    <pv_name>abtest:ioc-hkl:detimage</pv_name>
    <x>38</x>
    <y>59</y>
    <width>800</width>
    <x_axis>
      <visible>true</visible>
      <title>X</title>
      <minimum>0.0</minimum>
      <maximum>600.0</maximum>
      <title_font>
        <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
        </font>
      </title_font>
      <scale_font>
        <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
        </font>
      </scale_font>
    </x_axis>
    <y_axis>
      <visible>true</visible>
      <title>Y</title>
      <minimum>0.0</minimum>
      <maximum>254.0</maximum>
      <title_font>
        <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
        </font>
      </title_font>
      <scale_font>
        <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
        </font>
      </scale_font>
    </y_axis>
    <data_width>200</data_width>
    <data_height>91</data_height>
  </widget>
  <widget type="scaledslider" version="2.0.0">
    <name>Scaled Slider</name>
    <pv_name>$(Sys)cur_angle</pv_name>
    <x>346</x>
    <y>410</y>
    <width>430</width>
    <height>20</height>
    <level_hihi>175.0</level_hihi>
    <level_high>160.0</level_high>
    <level_low>-160.0</level_low>
    <level_lolo>-175.0</level_lolo>
    <show_hihi>false</show_hihi>
    <show_high>false</show_high>
    <show_low>false</show_low>
    <show_lolo>false</show_lolo>
    <border_alarm_sensitive>false</border_alarm_sensitive>
    <minimum>-180.0</minimum>
    <maximum>180.0</maximum>
    <limits_from_pv>false</limits_from_pv>
  </widget>
  <widget type="scaledslider" version="2.0.0">
    <name>Scaled Slider_1</name>
    <pv_name>$(Sys)y_offset</pv_name>
    <x>345</x>
    <y>480</y>
    <width>430</width>
    <height>20</height>
    <level_hihi>15.0</level_hihi>
    <level_high>12.0</level_high>
    <level_low>-12.0</level_low>
    <level_lolo>-15.0</level_lolo>
    <show_hihi>false</show_hihi>
    <show_high>false</show_high>
    <show_low>false</show_low>
    <show_lolo>false</show_lolo>
    <border_alarm_sensitive>false</border_alarm_sensitive>
    <minimum>-15.0</minimum>
    <maximum>15.0</maximum>
    <limits_from_pv>false</limits_from_pv>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>setup</name>
    <actions>
      <action type="write_pv">
        <description>Write PV</description>
        <pv_name>$(Sys)setup_vis</pv_name>
        <value>1</value>
      </action>
    </actions>
    <pv_name>$(Sys)setup_vis</pv_name>
    <text>start</text>
    <x>18</x>
    <y>439</y>
    <width>120</width>
    <border_alarm_sensitive>false</border_alarm_sensitive>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_11</name>
    <text>sample rotation (omega)</text>
    <x>180</x>
    <y>410</y>
    <width>166</width>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_12</name>
    <text>detector elevation</text>
    <x>208</x>
    <y>480</y>
    <width>120</width>
  </widget>
</display>
