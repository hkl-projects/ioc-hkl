#!../../bin/linux-x86_64/hklApp
#
# Example EPICS startup for a facility deployment (K4CV / kappa).
# Copy to beamline boot dir as st_base.cmd and customize PREFIX, defaults, motor links.
#
#   cp st_base_site.cmd.example /path/to/beamline-app/st_base.cmd
#
# See documentation/deploy/procServ-pixi.md

< envPaths

epicsEnvSet("PYTHONPATH","$(TOP)/python")

# Beamline:subsystem — confirm case with your site (EPICS PVs are case-sensitive)
epicsEnvSet("PREFIX", "BEAMLINE:hkl:")

cd ${TOP}

dbLoadDatabase "${TOP}/dbd/hklApp.dbd"
hklApp_registerRecordDeviceDriver pdbbase

dbLoadRecords("db/hkl_main.db")

cd ${TOP}/iocBoot/${IOC}

pydev("import hklApp")
pydev("hkl_calc = hklApp.hklCalcs()")

iocInit

epicsThreadSleep(1)

# Geometry: 2 = K4CV (three-circle kappa). Stock hkl K4CV uses α=50° unless patched.
dbpf("$(PREFIX)geom","2")

# Instrument defaults — set wavelength and lattice for your experiment
dbpf("$(PREFIX)wlen","1.486")
dbpf("$(PREFIX)latt_a","5.431")
dbpf("$(PREFIX)latt_b","5.431")
dbpf("$(PREFIX)latt_c","5.431")
dbpf("$(PREFIX)latt_alpha","90.")
dbpf("$(PREFIX)latt_beta","90.")
dbpf("$(PREFIX)latt_gamma","90.")

# K4CV axis soft limits (degrees)
dbpf("$(PREFIX)komega_k4c_min","-180.")
dbpf("$(PREFIX)kappa_k4c_min","-180.")
dbpf("$(PREFIX)kphi_k4c_min","-180.")
dbpf("$(PREFIX)tth_k4c_min","-180.")
dbpf("$(PREFIX)komega_k4c_max","180.")
dbpf("$(PREFIX)kappa_k4c_max","180.")
dbpf("$(PREFIX)kphi_k4c_max","180.")
dbpf("$(PREFIX)tth_k4c_max","180.")

# Optional: link readbacks to motor PVs, set UB matrix, reflections, etc.
# dbpf("$(PREFIX)komega_k4c","$(MOTOR_OMEGA_PV)")

dbl > pvlist.dbl
